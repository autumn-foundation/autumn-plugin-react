{
  "name": "autumn-plugin-react-dev",
  "private": true,
  "type": "module",
  "description": "Browser tests and the reference frontend for autumn-plugin-react. Not published.",
  "scripts": {
    "build:islands": "node frontend/build.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=30000 \"js-tests/*.test.mjs\"",
    "test:e2e": "node --test --test-timeout=120000 \"js-tests/e2e/*.test.mjs\"",
    "test:coverage": "node js-tests/run-coverage.mjs",
    "typecheck": "tsc -p frontend/tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
